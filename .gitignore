# Gradle and Android build outputs
**/.gradle/
**/.idea/
**/.kotlin/
**/build/
**/app/build/
*.class
*.aar

# APKs: ignore general build outputs, allow releases/
*.apk
!releases/*.apk
*.idsig

# System specific files
.DS_Store
Thumbs.db
*.tmp
*.log
*~

# Python Virtual Environments
.venv/
__pycache__/

# Large Firmware Images & Raw Dumps (Local only)
backup/
oneui9/
Frija/
tools/

# Private user recordings
registrazioni/

# Screenshots and logs
/scratch/
GEMINI.MD

# Signing material — never publish
*.keystore
*.jks

# Local agent session state
.claude/
android-app/local.properties
s24-launcher/local.properties
