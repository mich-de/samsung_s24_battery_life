<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:paddingHorizontal="16dp"
    android:paddingTop="36dp"
    android:paddingBottom="12dp">

    <!-- Top Time & Industrial Appliance Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Blinking / Steady Status LED -->
                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_tab_active"
                    android:layout_marginEnd="8dp" />

                <TextClock
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format24Hour="HH:mm"
                    android:format12Hour="hh:mm a"
                    android:textColor="@color/on_surface"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <TextClock
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:format24Hour="EEEE // dd.MM.yyyy"
                android:format12Hour="EEEE // MM.dd.yyyy"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginStart="15dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/badgePrime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01 // S24 APPLIANCE"
            android:textSize="10sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/accent"
            android:background="@drawable/bg_chip_tm"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Hero Card: HostAI Edge AI Engine (Teenage Engineering Hardware Card) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardHostAI"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="@color/surface"
        app:strokeColor="@color/line"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="HOSTAI STUDIO"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/on_surface" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OPENCL GPU // ONLINE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:textColor="@color/accent"
                    android:background="@drawable/bg_chip_tm"
                    android:paddingHorizontal="7dp"
                    android:paddingVertical="3dp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EXYNOS 2400 · AMD XCLIPSE 940 · 4.4 GB FREE RAM"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface_variant"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLaunchHostAI"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="[ LAUNCH CORE ]"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/primary"
                    android:textColor="#0E0E0E"
                    android:layout_marginEnd="5dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWebChat"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="[ WEB CHAT /chat ]"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    app:cornerRadius="8dp"
                    app:backgroundTint="@color/surface_card"
                    android:textColor="@color/accent"
                    app:strokeColor="@color/line"
                    app:strokeWidth="1dp"
                    android:layout_marginStart="5dp" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Search Bar (Command Terminal Style) -->
    <EditText
        android:id="@+id/searchBar"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_search"
        android:hint="> SEARCH SYSTEM APPS..."
        android:textColorHint="@color/on_surface_sub"
        android:textColor="@color/on_surface"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:paddingHorizontal="14dp"
        android:inputType="text"
        android:maxLines="1"
        android:layout_marginBottom="8dp" />

    <!-- Drawer Category Tabs (Technical Minimal Monospace Pills) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ ALL ]"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:textColor="#0E0E0E"
                android:background="@drawable/bg_tab_active"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tabAI"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 01 // AI &amp; TOOLS ]"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface_variant"
                android:background="@drawable/bg_tab_inactive"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tabStores"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 02 // NET &amp; STORES ]"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface_variant"
                android:background="@drawable/bg_tab_inactive"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tabSystem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 03 // SYSTEM ]"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface_variant"
                android:background="@drawable/bg_tab_inactive"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/tabSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ // CONFIG ]"
                android:textSize="11sp"
                android:fontFamily="monospace"
                android:textColor="@color/accent"
                android:background="@drawable/bg_chip_tm"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Fast App Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="96dp"
        android:scrollbars="vertical" />

</LinearLayout>
